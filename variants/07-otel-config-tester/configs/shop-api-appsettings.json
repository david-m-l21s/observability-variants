{
  "fw": "net9.0",
  "comments": true,
  "serviceName": "shop-api",
  "serviceNamespace": "t2a",
  "serviceVersion": "",
  "versionFromAssembly": false,
  "envAttr": true,
  "k8sAttrs": true,
  "resAttrs": "",
  "sampler": "parentAlwaysOn",
  "ratio": "0.25",
  "aspnet": true,
  "aspRecordEx": true,
  "aspEnrichEx": true,
  "aspFilter": true,
  "filterPaths": [
    "/health",
    "/healthz",
    "/ready",
    "/alive",
    "/metrics"
  ],
  "customPaths": "",
  "filterExt": false,
  "filterOptions": true,
  "captureHeaders": "x-tenant-id\nx-correlation-id",
  "signalrOff": false,
  "razorOff": false,
  "http": true,
  "httpRecordEx": true,
  "httpEnrichEx": true,
  "httpFilter": true,
  "httpExcludeHosts": "otel-collector",
  "httpExcludePaths": "/health",
  "grpc": false,
  "efcore": true,
  "efSemconv": true,
  "efLogWarn": true,
  "sqlclient": false,
  "npgsql": false,
  "redis": false,
  "sources": "T2A.Shop",
  "massTransit": false,
  "azure": false,
  "otlp": true,
  "otlpEndpointMode": "appsettings",
  "otlpEndpoint": "http://otel-collector:4317",
  "otlpConfigKey": "OpenTelemetry:Otlp:Endpoint",
  "batchDelay": "",
  "batchQueue": "",
  "batchSize": "",
  "console": "dev",
  "limValueLen": "4096",
  "limAttrCount": "64",
  "limEventCount": "32",
  "limLinkCount": "32",
  "limEventAttrCount": "16",
  "limLinkAttrCount": "16"
}
