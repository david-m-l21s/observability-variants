<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 02-runtime-injection: no OpenTelemetry NuGet packages. The OTel Operator
       injects the .NET auto-instrumentation agent at runtime instead. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
